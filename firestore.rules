rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(hid) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    // Copia personal: solo su dueño
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Códigos de invitación de pareja
    match /invites/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    // Espacio compartido de pareja
    match /households/{hid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members ||
        (
          // Unirse con un código válido: solo puede añadirse a sí mismo
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'photos', 'joinCode']) &&
          request.resource.data.members.size() == resource.data.members.size() + 1 &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.auth.uid in request.resource.data.members &&
          get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.hid == hid
        )
      );
      match /docs/{docId} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
